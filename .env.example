# Erply Books API credentials
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# API docs: https://www.erplybooks.com/api/
# Swagger:  https://www.erplybooks.com/api-documentation
#
# Erply Books API tokens may be IP-allowlisted; make sure the machine running
# this server is on the token's allowlist.

ERPLY_BOOKS_API_TOKEN=your_api_token

# Base URL (default if omitted):
# ERPLY_BOOKS_API_BASE_URL=https://api.erplybooks.com/api

# Optional HTTP retry (transient 5xx / 429 / 408 and network failures only; default 0 = off)
# ERPLY_BOOKS_HTTP_MAX_RETRIES=2
# ERPLY_BOOKS_HTTP_RETRY_BASE_MS=500

# Outbound request timeout in ms (default 30000)
# ERPLY_BOOKS_REQUEST_TIMEOUT_MS=30000

# Structured logs (stderr only; stdout is reserved for MCP)
# LOG_LEVEL=info
